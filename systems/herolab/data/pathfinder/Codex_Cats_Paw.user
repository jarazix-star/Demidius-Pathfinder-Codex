<?xml version="1.0" encoding="UTF-8"?>
<document signature="Hero Lab Data">
  <thing id="ioCdxCatPw" name="Cat's Paw"
    description="This small enchanted charm resembles a softly padded feline paw. While carried and equipped, it grants a +15 competence bonus on Stealth checks. Cat's Paw is slotless and does not prevent its bearer from wearing any other magic item."
    compset="Wondrous">
    <fieldval field="gWeight" value="0"/>
    <tag group="gType" tag="Wonder"/>
    <tag group="Helper" tag="EquipAvail"/>
    <tag group="Helper" tag="EquipMag"/>
    <tag group="Helper" tag="ShowSpec"/>
    <eval phase="Final" priority="10000"><![CDATA[
      doneif (field[gIsEquip].value = 0)
      #applybonus[BonComp,hero.childfound[skStealth],15]
      ]]></eval>
    </thing>
  </document>
