<?xml version="1.0" encoding="UTF-8"?>
<document signature="Hero Lab Data">
  <loadonce key="Codex Divine Agent MCA"/>

  <!--
    Divine Agent (Cleric/Rogue multiclass archetype)
    Rules: d20PFSRD Cartmanbeck MCA
    HL base recipe: ShadowChemosh (WolfLair thread 59636) + Codex rule fixes 2026-07-28

    Helper cHelpS2DiA / ClassLevel cS2DivAge keep SC IDs so forum recipes still match.
    Install ONLY this file OR PFRPG_Divine_Agent.user — never both.
  -->

