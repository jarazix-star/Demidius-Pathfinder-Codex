  </thing>
  <thing id="xCdxFlw1" name="Fatal Flaw Slot 1" description="Choose one Fatal Flaw from the canonical campaign catalog." compset="Ability" uniqueness="unique">
    <fieldval field="usrCandid1" value="Custom.CdxFatal" />
    <fieldval field="abValue" value="1" />
    <tag group="Helper" tag="ShowSpec" />
    <eval phase="Render" priority="50000"><![CDATA[
      if (field[usrChosen1].ischosen = 0) then
        perform delete[Helper.ShowSpec]
      else
        field[sbName].text = "Godling Fatal Flaw|Slot=1|Name=" & field[usrChosen1].chosen.field[name].text & "|DC=" & hero.child[xCdxGodCfg].field[abValue].value
        endif
    ]]></eval>
  </thing>
  <thing id="xCdxFlw2" name="Fatal Flaw Slot 2" description="Choose one Fatal Flaw from the canonical campaign catalog." compset="Ability" uniqueness="unique">
    <fieldval field="usrCandid1" value="Custom.CdxFatal" />
    <fieldval field="abValue" value="2" />
    <tag group="Helper" tag="ShowSpec" />
    <eval phase="Render" priority="50000"><![CDATA[
