<?xml version="1.0" encoding="UTF-8"?>
<document signature="Hero Lab Data">
  <fileinfo>
    <info_author>Demidius Pathfinder Codex</info_author>
    <info_history><![CDATA[
      2026-08-02
      - Added the canonical Godling bloodline power catalog from the campaign workbook.
      - Automated direct ability bonuses, natural armor, flight, and energy resistance.
      - Added prerequisite chains for Lesser/Greater/Master power families.
      - Replaced the manual Major God Stats 2 entry with six automated
        secondary-stat choices that also add +2 to the selected Stats 1 stat.
      - Complex companion, template, spell, item, breath, immunity, and negotiated
        effects remain selectable and fully documented for manual adjudication.
    ]]></info_history>
  </fileinfo>

  <!-- Ability-score choices. Select only an ancestor-approved statistic. -->
  <thing id="mCdxS1Str" name="Stats 1: Strength" description="Gain +4 Strength. Select this only when Strength is one of the favored statistics granted by the chosen ancestor. Hero Lab automation: adds +4 Strength." compset="CdxGodPwr" summary="+4 Strength" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10000"><![CDATA[hero.child[aSTR].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS1Dex" name="Stats 1: Dexterity" description="Gain +4 Dexterity. Select this only when Dexterity is one of the favored statistics granted by the chosen ancestor. Hero Lab automation: adds +4 Dexterity." compset="CdxGodPwr" summary="+4 Dexterity" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10000"><![CDATA[hero.child[aDEX].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS1Con" name="Stats 1: Constitution" description="Gain +4 Constitution. Select this only when Constitution is one of the favored statistics granted by the chosen ancestor. Hero Lab automation: adds +4 Constitution." compset="CdxGodPwr" summary="+4 Constitution" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10000"><![CDATA[hero.child[aCON].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS1Int" name="Stats 1: Intelligence" description="Gain +4 Intelligence. Select this only when Intelligence is one of the favored statistics granted by the chosen ancestor. Hero Lab automation: adds +4 Intelligence." compset="CdxGodPwr" summary="+4 Intelligence" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10000"><![CDATA[hero.child[aINT].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS1Wis" name="Stats 1: Wisdom" description="Gain +4 Wisdom. Select this only when Wisdom is one of the favored statistics granted by the chosen ancestor. Hero Lab automation: adds +4 Wisdom." compset="CdxGodPwr" summary="+4 Wisdom" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10000"><![CDATA[hero.child[aWIS].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS1Cha" name="Stats 1: Charisma" description="Gain +4 Charisma. Fey ancestry uses Charisma. Other bloodlines may select this when Charisma is an ancestor-approved favored statistic. Hero Lab automation: adds +4 Charisma." compset="CdxGodPwr" summary="+4 Charisma" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10000"><![CDATA[hero.child[aCHA].field[aPostMod].value += 4]]></eval>
  </thing>

  <thing id="mCdxS2Str" name="Stats 2: Strength" description="Gain +4 Strength as the second favored statistic. It must be different from the statistic selected for Stats 1. Hero Lab automation: adds +4 Strength." compset="CdxGodPwr" summary="Second favored stat: +4 Strength" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10001"><![CDATA[hero.child[aSTR].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS2Dex" name="Stats 2: Dexterity" description="Gain +4 Dexterity as the second favored statistic. It must be different from the statistic selected for Stats 1. Hero Lab automation: adds +4 Dexterity." compset="CdxGodPwr" summary="Second favored stat: +4 Dexterity" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10001"><![CDATA[hero.child[aDEX].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS2Con" name="Stats 2: Constitution" description="Gain +4 Constitution as the second favored statistic. It must be different from the statistic selected for Stats 1. Hero Lab automation: adds +4 Constitution." compset="CdxGodPwr" summary="Second favored stat: +4 Constitution" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10001"><![CDATA[hero.child[aCON].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS2Int" name="Stats 2: Intelligence" description="Gain +4 Intelligence as the second favored statistic. It must be different from the statistic selected for Stats 1. Hero Lab automation: adds +4 Intelligence." compset="CdxGodPwr" summary="Second favored stat: +4 Intelligence" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10001"><![CDATA[hero.child[aINT].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS2Wis" name="Stats 2: Wisdom" description="Gain +4 Wisdom as the second favored statistic. It must be different from the statistic selected for Stats 1. Hero Lab automation: adds +4 Wisdom." compset="CdxGodPwr" summary="Second favored stat: +4 Wisdom" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10001"><![CDATA[hero.child[aWIS].field[aPostMod].value += 4]]></eval>
  </thing>
  <thing id="mCdxS2Cha" name="Stats 2: Charisma" description="Gain +4 Charisma as the second favored statistic. Fey ancestry may take this as its second +4 Charisma power. Hero Lab automation: adds +4 Charisma." compset="CdxGodPwr" summary="Second favored stat: +4 Charisma" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10001"><![CDATA[hero.child[aCHA].field[aPostMod].value += 4]]></eval>
  </thing>
  <!-- Major God Stats 2 choices. Each named choice is the secondary favored
       statistic; the scripts also add +2 to whichever Stats 1 pick is live. -->
  <thing id="mCdxS2Maj" name="Stats 2: STR (Major God)" description="Major God only: gain +4 Strength as the secondary favored statistic and add +2 to the statistic selected for Stats 1. Strength should be different from the Stats 1 statistic. Hero Lab automation: applies both bonuses." compset="CdxGodPwr" summary="Major God: +2 primary, +4 Strength" uniqueness="useronce">
    <tag group="Custom" tag="CdxGodPow"/>
    <eval phase="Attr" priority="10002"><![CDATA[
      hero.child[aSTR].field[aPostMod].value += 4
      if (hero.childlives[mCdxS1Str] <> 0) then
        hero.child[aSTR].field[aPostMod].value += 2
        endif
      if (hero.childlives[mCdxS1Dex] <> 0) then
        hero.child[aDEX].field[aPostMod].value += 2
        endif
      if (hero.childlives[mCdxS1Con] <> 0) then
        hero.child[aCON].field[aPostMod].value += 2
        endif
      if (hero.childlives[mCdxS1Int] <> 0) then
        hero.child[aINT].field[aPostMod].value += 2
        endif
      if (hero.childlives[mCdxS1Wis] <> 0) then
        hero.child[aWIS].field[aPostMod].value += 2
        endif
      if (hero.childlives[mCdxS1Cha] <> 0) then
        hero.child[aCHA].field[aPostMod].value += 2
        endif
    ]]></eval>
  </thing>
  <thing id="mCdxMjDex" name="Stats 2: DEX (Major God)" description="Major God only: gain +4 Dexterity as the secondary favored statistic and add +2 to the statistic selected for Stats 1. Dexterity should be different from the Stats 1 statistic. Hero Lab automation: applies both bonuses." compset="CdxGodPwr" summary="Major God: +2 primary, +4 Dexterity" uniqueness="useronce">
