<?xml version="1.0" encoding="UTF-8"?>
<document signature="Hero Lab Structure">
  <!-- Pathfinder's compiled UI does not expose a reusable text-edit style to
       user data. Keep this visual extension separate from the .1st tag groups. -->
  <resource id="fntCdxEd">
    <font face="Arial" size="36"/>
  </resource>
  <resource id="clrCdxTxt">
    <color color="000000"/>
  </resource>
  <resource id="clrCdxBck">
    <color color="f2eee0"/>
  </resource>
  <style id="cdxEdit" border="sunken">
    <style_edit textcolorid="clrCdxTxt" backcolorid="clrCdxBck" font="fntCdxEd"/>
  </style>
</document>
