  <template id="cdxFlw06" name="Fatal Flaw Selection 6" compset="Ability" marginhorz="5" marginvert="2">
    <portal id="gfSlotLb" style="lblNormal"><label text="Fatal Flaw 6:"/></portal>
    <portal id="gfSlot" style="menuNormal"><menu_things field="usrChosen1" component="Ability" candidatefield="usrCandid1" maxvisible="20"/></portal>
    <position><![CDATA[
      if (hero.child[xCdxGodCfg].field[abValue3].value < 6) then
