        endif
    ]]></position>
  </template>

  <layout id="cdxGodLay">
    <portalref portal="gpPowers" taborder="20"/>
    <portalref portal="myOthAbil" taborder="21"/>
    <portalref portal="myPathAbil" taborder="22"/>
    <portalref portal="myFeat" taborder="23"/>
    <templateref template="cdxGodMain" thing="xCdxGodCfg" taborder="10"/>
    <templateref template="cdxGodAdj" thing="xCdxGodAdj" taborder="30"/>
    <templateref template="cdxFlw01" thing="xCdxFlw1" taborder="31"/>
    <templateref template="cdxFlw02" thing="xCdxFlw2" taborder="32"/>
    <templateref template="cdxFlw03" thing="xCdxFlw3" taborder="33"/>
    <templateref template="cdxFlw04" thing="xCdxFlw4" taborder="34"/>
    <templateref template="cdxFlw05" thing="xCdxFlw5" taborder="35"/>
    <templateref template="cdxFlw06" thing="xCdxFlw6" taborder="36"/>
    <position><![CDATA[
      perform template[cdxGodMain].autoplace
      portal[gpPowers].width = width
      portal[myOthAbil].width = width
      portal[myPathAbil].width = width
      portal[myFeat].width = width
      perform portal[gpPowers].autoplace
      perform portal[myOthAbil].autoplace
      perform portal[myPathAbil].autoplace
      perform portal[myFeat].autoplace
      perform template[cdxGodAdj].autoplace
      perform template[cdxFlw01].autoplace
      perform template[cdxFlw02].autoplace
      perform template[cdxFlw03].autoplace
      perform template[cdxFlw04].autoplace
      perform template[cdxFlw05].autoplace
      perform template[cdxFlw06].autoplace
    ]]></position>
  </layout>

  <panel id="cdxGodPwr" name="Godly Powers" marginhorz="5" marginvert="5" order="365">
    <live>CdxGodStr.Active</live>
    <layoutref layout="cdxGodLay"/>
    <position><![CDATA[]]></position>
  </panel>
</document>
