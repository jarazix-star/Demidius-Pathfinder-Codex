    <tag group="Helper" tag="Helper"/>
  </thing>

  <thing id="xCdxGodAdj" name="Fatal Flaw DC Adjustment" description="Optional campaign adjustment to the calculated Fatal Flaw save DC. Leave this at 0 for the standard formula. Pure Mortal always remains DC 0." compset="Ability" uniqueness="unique">
    <fieldval field="actUserMin" value="-50"/>
    <fieldval field="actUserMax" value="50"/>
  </thing>

  <thing id="tmCdxGPMor" name="Godling Bloodline: Pure Mortal" description="Pure Mortal bloodline strength. Activates the Godly Powers tab. Fatal Flaw save DC and Fatal Flaws earned are always 0, and this template grants no Godly Powers. Mythic Tier and native Mythic powers remain available." compset="Template" uniqueness="unique">
    <arrayval field="tmCRArray" index="0" value="0"/>
    <tag group="TemplHelp" tag="Acquired"/>
    <bootstrap thing="xCdxGodCfg"><autotag group="CdxGodStr" tag="Pure"/></bootstrap>
    <bootstrap thing="xCdxGodAdj"/>
    <bootstrap thing="xCdxFlw1"/><bootstrap thing="xCdxFlw2"/><bootstrap thing="xCdxFlw3"/>
    <bootstrap thing="xCdxFlw4"/><bootstrap thing="xCdxFlw5"/><bootstrap thing="xCdxFlw6"/>
    <exprreq message="Choose only one Godling Bloodline strength."><![CDATA[
      hero.childlives[tmCdxGP18] + hero.childlives[tmCdxGP14] + hero.childlives[tmCdxGPDem] + hero.childlives[tmCdxGPMGo] = 0
    ]]></exprreq>
  </thing>

  <thing id="tmCdxGP18" name="Godling Bloodline: 1/8 Godling" description="One-eighth Godling bloodline strength. Fatal Flaw save DC equals character level + 10, plus any campaign adjustment. Godly Power selections are reserved for v2." compset="Template" uniqueness="unique">
    <arrayval field="tmCRArray" index="0" value="0"/>
    <tag group="TemplHelp" tag="Acquired"/>
    <bootstrap thing="xCdxGodCfg"><autotag group="CdxGodStr" tag="Eighth"/></bootstrap>
    <bootstrap thing="xCdxGodAdj"/>
    <bootstrap thing="xCdxFlw1"/><bootstrap thing="xCdxFlw2"/><bootstrap thing="xCdxFlw3"/>
    <bootstrap thing="xCdxFlw4"/><bootstrap thing="xCdxFlw5"/><bootstrap thing="xCdxFlw6"/>
    <exprreq message="Choose only one Godling Bloodline strength."><![CDATA[
      hero.childlives[tmCdxGPMor] + hero.childlives[tmCdxGP14] + hero.childlives[tmCdxGPDem] + hero.childlives[tmCdxGPMGo] = 0
    ]]></exprreq>
  </thing>

  <thing id="tmCdxGP14" name="Godling Bloodline: 1/4 Godling" description="One-quarter Godling bloodline strength. Fatal Flaw save DC equals character level + 15, plus any campaign adjustment. Godly Power selections are reserved for v2." compset="Template" uniqueness="unique">
    <arrayval field="tmCRArray" index="0" value="0"/>
    <tag group="TemplHelp" tag="Acquired"/>
    <bootstrap thing="xCdxGodCfg"><autotag group="CdxGodStr" tag="Quarter"/></bootstrap>
    <bootstrap thing="xCdxGodAdj"/>
    <bootstrap thing="xCdxFlw1"/><bootstrap thing="xCdxFlw2"/><bootstrap thing="xCdxFlw3"/>
    <bootstrap thing="xCdxFlw4"/><bootstrap thing="xCdxFlw5"/><bootstrap thing="xCdxFlw6"/>
    <exprreq message="Choose only one Godling Bloodline strength."><![CDATA[
      hero.childlives[tmCdxGPMor] + hero.childlives[tmCdxGP18] + hero.childlives[tmCdxGPDem] + hero.childlives[tmCdxGPMGo] = 0
    ]]></exprreq>
  </thing>

  <thing id="tmCdxGPDem" name="Godling Bloodline: Demigod" description="Demigod bloodline strength. Fatal Flaw save DC equals character level + 20, plus any campaign adjustment. Godly Power selections are reserved for v2." compset="Template" uniqueness="unique">
    <arrayval field="tmCRArray" index="0" value="0"/>
    <tag group="TemplHelp" tag="Acquired"/>
    <bootstrap thing="xCdxGodCfg"><autotag group="CdxGodStr" tag="Demigod"/></bootstrap>
    <bootstrap thing="xCdxGodAdj"/>
    <bootstrap thing="xCdxFlw1"/><bootstrap thing="xCdxFlw2"/><bootstrap thing="xCdxFlw3"/>
    <bootstrap thing="xCdxFlw4"/><bootstrap thing="xCdxFlw5"/><bootstrap thing="xCdxFlw6"/>
    <exprreq message="Choose only one Godling Bloodline strength."><![CDATA[
      hero.childlives[tmCdxGPMor] + hero.childlives[tmCdxGP18] + hero.childlives[tmCdxGP14] + hero.childlives[tmCdxGPMGo] = 0
    ]]></exprreq>
  </thing>

  <thing id="tmCdxGPMGo" name="Godling Bloodline: Mortal God" description="Mortal God bloodline strength. Fatal Flaw save DC equals character level + 25, plus any campaign adjustment. Godly Power selections are reserved for v2." compset="Template" uniqueness="unique">
    <arrayval field="tmCRArray" index="0" value="0"/>
    <tag group="TemplHelp" tag="Acquired"/>
    <bootstrap thing="xCdxGodCfg"><autotag group="CdxGodStr" tag="MortGod"/></bootstrap>
    <bootstrap thing="xCdxGodAdj"/>
    <bootstrap thing="xCdxFlw1"/><bootstrap thing="xCdxFlw2"/><bootstrap thing="xCdxFlw3"/>
    <bootstrap thing="xCdxFlw4"/><bootstrap thing="xCdxFlw5"/><bootstrap thing="xCdxFlw6"/>
    <exprreq message="Choose only one Godling Bloodline strength."><![CDATA[
      hero.childlives[tmCdxGPMor] + hero.childlives[tmCdxGP18] + hero.childlives[tmCdxGP14] + hero.childlives[tmCdxGPDem] = 0
    ]]></exprreq>
  </thing>

  <!-- Deity-granted templates from the Godling ruleset. -->
  <thing id="tmCdxGodCh" name="God's Champion" description="A deity has elevated this character as a chosen champion. The template grants a +2 increase to natural armor, +4 to Strength, Dexterity, Constitution, Intelligence, Wisdom, and Charisma, and two additional Godly Power selections. Requires an active non-Pure Mortal Godling Bloodline." compset="Template" uniqueness="unique">
    <arrayval field="tmCRArray" index="0" value="0"/>
    <tag group="TemplHelp" tag="Acquired"/>
    <eval phase="Attr" priority="10000" index="1"><![CDATA[
      hero.child[aSTR].field[aPostMod].value += 4
      hero.child[aDEX].field[aPostMod].value += 4
      hero.child[aCON].field[aPostMod].value += 4
      hero.child[aINT].field[aPostMod].value += 4
      hero.child[aWIS].field[aPostMod].value += 4
      hero.child[aCHA].field[aPostMod].value += 4
      hero.child[ArmorClass].field[tACNatural].value += 2
    ]]></eval>
    <eval phase="PostLevel" priority="12000" index="2"><![CDATA[
      hero.child[resCdxGod].field[resMax].value += 2
    ]]></eval>
    <exprreq message="God's Champion requires an active non-Pure Mortal Godling Bloodline."><![CDATA[
      hero.childlives[xCdxGodCfg] + hero.tagis[CdxGodStr.Pure] = 1
    ]]></exprreq>
  </thing>

  <thing id="tmCdxGodBl" name="God's Blessed" description="A deity has bestowed an enduring blessing on this character. The template grants a +2 increase to natural armor and +4 to Strength, Dexterity, Constitution, Intelligence, Wisdom, and Charisma." compset="Template" uniqueness="unique">
    <arrayval field="tmCRArray" index="0" value="0"/>
    <tag group="TemplHelp" tag="Acquired"/>
    <eval phase="Attr" priority="10000" index="1"><![CDATA[
      hero.child[aSTR].field[aPostMod].value += 4
      hero.child[aDEX].field[aPostMod].value += 4
      hero.child[aCON].field[aPostMod].value += 4
      hero.child[aINT].field[aPostMod].value += 4
      hero.child[aWIS].field[aPostMod].value += 4
      hero.child[aCHA].field[aPostMod].value += 4
      hero.child[ArmorClass].field[tACNatural].value += 2
    ]]></eval>
  </thing>
</document>
