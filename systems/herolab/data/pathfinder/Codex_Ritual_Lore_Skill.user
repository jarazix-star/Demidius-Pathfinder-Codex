<?xml version="1.0" encoding="UTF-8"?>
<document signature="Hero Lab Data">
  <thing id="skCdxRitLo"
         name="Ritual Lore"
         description="Ritual Lore represents specialized knowledge of ceremonial magic, occult procedures, divine rites, arcane circles, sacrifices, bindings, and the safe performance or analysis of rituals. It can be used to recognize ritual traditions, interpret ritual symbols and instructions, identify likely components or hazards, and recall lore about known rituals. The exact information available and the DC of a check remain subject to the Game Master's ruling. Ritual Lore is an Intelligence-based, trained-only background skill and is always a class skill."
         compset="Skill"
         uniqueness="useronce">
    <fieldval field="skShortNm" value="Ritual Lore"/>
    <fieldval field="skAbbrev" value="Ritual"/>
    <tag group="Helper" tag="TrainOnly"/>
    <tag group="Helper" tag="ExtraSkill"/>
    <tag group="Helper" tag="BackSkill"/>
    <tag group="Helper" tag="ConsBack"/>
    <link linkage="skillattr" thing="aINT"/>
  </thing>

  <thing id="mCdxRitCS"
         name="House Rule: Ritual Lore Is Always a Class Skill"
         description="Ritual Lore is a class skill for every character."
         compset="Mechanics"
         uniqueness="unique">
    <eval phase="First" priority="1000"><![CDATA[
      perform hero.assign[ClassSkill.skCdxRitLo]
    ]]></eval>
  </thing>
</document>
